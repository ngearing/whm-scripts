# Copy to .env and fill in. .env is gitignored - never commit real credentials.
# Values already exported in your shell win over this file.
#
# One .env per reseller account also works:
#   DOTENV_PATH=.env.shock-2 php sync_whm_accounts.php

# --- WHM reseller account ----------------------------------------------
WHM_HOST=server3.shockhosting.com
WHM_PORT=2087
WHM_USERNAME=your_reseller_username
WHM_API_TOKEN=
# Tags every synced row with the account it came from (shock-1, shock-2, ...).
# Defaults to "host:username" if left out.
WHM_SOURCE_LABEL=shock-1

# --- Synergy Wholesale (sync_synergy_domains.php) ----------------------
SYNERGY_RESELLER_ID=
SYNERGY_API_KEY=

# --- Optional ------------------------------------------------------------
# DB_PATH=websites.sqlite          # relative paths are relative to this folder
# OUTPUT_DIR=output
# PHP_TARGET_VERSION=ea-php83      # upgrade_php_versions.php
# WP_SCAN_MAX_DEPTH=2              # check_wordpress*.php
# WP_SCAN_MAX_DIRS=150
# ERRLOG_MAX_FETCH_BYTES=1048576   # check_error_logs.php
# ERRLOG_TAIL_CHARS=2000
# PLUGIN_SLUG=                     # find_plugin_installs.php (or pass as argument)
# PLUGIN_MATCH=exact               # exact | contains
# WITH_VERSION=1
